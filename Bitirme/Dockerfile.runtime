FROM eclipse-temurin:21-jre

WORKDIR /app

RUN groupadd -g 10001 appgroup && \
    useradd -u 10001 -g appgroup -m -s /usr/sbin/nologin appuser && \
    mkdir -p /app/data && \
    chown -R appuser:appgroup /app

COPY --chown=appuser:appgroup server/build/libs/brokyfood-server-all.jar /app/app.jar
COPY --chown=appuser:appgroup app/build/outputs/apk/debug/app-debug.apk /app/brokyfood.apk

USER 10001:10001

ENV PORT=8080 \
    DB_PATH=/app/data/brokyfood.db \
    APK_PATH=/app/brokyfood.apk \
    JAVA_TOOL_OPTIONS="-XX:MaxRAMPercentage=60.0 -XX:+UseSerialGC"

EXPOSE 8080

HEALTHCHECK --interval=15s --timeout=5s --start-period=10s --retries=3 \
    CMD curl -fsS http://127.0.0.1:8080/api/health || exit 1

ENTRYPOINT ["java", "-jar", "/app/app.jar"]
